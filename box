#!/usr/bin/env bash
set -euo pipefail
P=box-
BIND=${BOX_BIND:-0.0.0.0}   # BOX_BIND=127.0.0.1 to allow access from the host only
SFTP_IMG=localhost/box-sftp

# SFTP sidecar (Alpine). Root login disabled, regular user only.
ensure_sftp_image() {
  podman image exists "$SFTP_IMG" && return
  podman build -q -t "$SFTP_IMG" - >/dev/null <<'EOF'
FROM alpine:3.20
RUN apk add --no-cache openssh-server shadow && ssh-keygen -A
CMD ["/usr/sbin/sshd","-D","-e","-o","PermitRootLogin=no","-o","PasswordAuthentication=yes","-o","ForceCommand=internal-sftp"]
EOF
}

# Runs inside the box as root. The password hash arrives on stdin (first line).
PROVISION='
IFS= read -r BOX_HASH
[ -n "$BOX_HASH" ] || { echo "ERROR: empty password hash"; exit 1; }
U=$BOX_USER; ID=$BOX_UID
# remove entries that clash by name or UID (e.g. "ubuntu" uid 1000 in ubuntu images)
sed -i "/^$U:/d; /^[^:]*:[^:]*:$ID:/d" /etc/passwd
sed -i "/^$U:/d; /^[^:]*:[^:]*:$ID:/d" /etc/group
[ -f /etc/shadow ] && sed -i "/^$U:/d" /etc/shadow

# install sudo and bash if missing
need=""
command -v sudo >/dev/null 2>&1 || need="sudo"
command -v bash >/dev/null 2>&1 || need="$need bash"
if [ -n "$need" ]; then
  echo "Installing: $need"
  if   command -v apt-get >/dev/null 2>&1; then export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && apt-get install -y -qq $need </dev/null
  elif command -v dnf     >/dev/null 2>&1; then dnf install -y $need </dev/null
  elif command -v yum     >/dev/null 2>&1; then yum install -y $need </dev/null
  elif command -v apk     >/dev/null 2>&1; then apk add --no-cache $need
  elif command -v pacman  >/dev/null 2>&1; then pacman -Sy --noconfirm $need </dev/null
  elif command -v zypper  >/dev/null 2>&1; then zypper -n install $need </dev/null
  else echo "WARNING: unknown package manager, please install manually: $need"; fi
fi

SH=/bin/sh; command -v bash >/dev/null 2>&1 && SH=$(command -v bash)
echo "$U:x:$ID:" >> /etc/group
echo "$U:x:$ID:$ID::/home/$U:$SH" >> /etc/passwd
touch /etc/shadow; chmod 640 /etc/shadow
printf "%s:%s:19000:0:99999:7:::\n" "$U" "$BOX_HASH" >> /etc/shadow

mkdir -p /home/$U
[ -d /etc/skel ] && cp -rn /etc/skel/. /home/$U/ 2>/dev/null || true
chown -R $ID:$ID /home/$U

# sudo requires the user password
if command -v sudo >/dev/null 2>&1; then
  mkdir -p /etc/sudoers.d
  grep -qs "^[#@]includedir /etc/sudoers.d" /etc/sudoers || echo "#includedir /etc/sudoers.d" >> /etc/sudoers
  echo "$U ALL=(ALL:ALL) ALL" > /etc/sudoers.d/$U
  chmod 440 /etc/sudoers.d/$U
else
  echo "WARNING: sudo is not installed in this box"
fi
'

free_port() {
  local p=2200
  while ss -ltn | grep -q ":$p " || podman ps -a --format '{{.Ports}}' | grep -q ":$p->"; do p=$((p+1)); done
  echo $p
}
label() { podman inspect -f "{{index .Config.Labels \"$2\"}}" "$1"; }
port_of() { label "$P$1-sftp" box.port; }
user_of() { label "$P$1" box.user; }

case "${1:-}" in
  new)   # box new <name> [image] [user]
    n=${2:?missing box name}; img=${3:-debian:12}; u=${4:-$USER}
    command -v openssl >/dev/null || { echo "openssl is required on the host to hash the password"; exit 1; }
    read -rsp "Password for '$u' (used for sudo and SFTP): " pw; echo
    read -rsp "Confirm password: " pw2; echo
    [ "$pw" = "$pw2" ] || { echo "Passwords do not match"; exit 1; }
    hash=$(printf '%s' "$pw" | openssl passwd -6 -stdin)
    [ -n "$hash" ] || { echo "Failed to hash the password"; exit 1; }
    uid=$(id -u)
    ensure_sftp_image
    port=$(free_port)
    podman volume create "$P$n-home" >/dev/null
    podman run -d --name "$P$n" --hostname "$n" --label box.user="$u" \
      -v "$P$n-home:/home/$u" "$img" sleep infinity >/dev/null
    echo "Setting up user and sudo (may take a while on first run)..."
    printf '%s\n' "$hash" | podman exec -i -u 0 -e BOX_USER="$u" -e BOX_UID="$uid" \
      "$P$n" sh -c "$PROVISION"
    podman run -d --name "$P$n-sftp" --label box.port="$port" --label box.user="$u" \
      -p "$BIND:$port:22" -v "$P$n-home:/home/$u" "$SFTP_IMG" >/dev/null
    podman exec -u 0 "$P$n-sftp" adduser -D -H -u "$uid" "$u"
    printf '%s:%s\n' "$u" "$pw" | podman exec -i -u 0 "$P$n-sftp" chpasswd
    echo
    echo "Created box '$n' (user: $u)"
    echo "  Shell:   box enter $n"
    echo "  Dolphin: sftp://$u@$(hostname):$port/home/$u"
    ;;
  enter)
    n=${2:?missing box name}; u=$(user_of "$n")
    podman start "$P$n" "$P$n-sftp" >/dev/null 2>&1 || true
    podman exec -it -u "$u" -w "/home/$u" "$P$n" sh -c 'exec $(command -v bash || echo sh) -l'
    ;;
  root)  # root shell inside the box: box root <name>
    n=${2:?missing box name}
    podman start "$P$n" >/dev/null 2>&1 || true
    podman exec -it -u 0 -w /root "$P$n" sh -c 'exec $(command -v bash || echo sh) -l'
    ;;
  info)
    n=${2:?missing box name}; u=$(user_of "$n")
    echo "sftp://$u@$(hostname):$(port_of "$n")/home/$u"
    ;;
  ls)
    podman ps -a --filter "name=^$P" --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
    ;;
  stop)
    n=${2:?missing box name}; podman stop "$P$n" "$P$n-sftp"
    ;;
  rm)
    n=${2:?missing box name}
    podman rm -f "$P$n" "$P$n-sftp"
    podman volume rm "$P$n-home"
    ;;
  *)
    echo "Usage: box {new <name> [image] [user] | enter <name> | root <name> | info <name> | ls | stop <name> | rm <name>}"
    ;;
esac
